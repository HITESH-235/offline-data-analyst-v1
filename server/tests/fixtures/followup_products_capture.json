{
  "baseline": {
    "question": "Standalone question: join Products to Order Details on ProductID. Sum Quantity for each ProductName across the complete dataset. Return only the five products with the most units sold, sorted descending, with a horizontal bar chart. Limit both the table and chart to five products.",
    "plan": {
      "intent": "SIMPLE",
      "context_action": "standalone",
      "analysis_plan": {
        "source": {
          "tables": [
