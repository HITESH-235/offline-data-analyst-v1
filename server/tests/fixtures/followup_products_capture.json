              "sort_by": "total_quantity_sold",
              "ascending": false,
              "limit": 5
            }
          }
        ],
        "chart_scope": {
          "preference": "required",
          "top_n": 5
        },
        "presentation": {
          "table_in_chat": true
        }
      }
    }
